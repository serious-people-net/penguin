---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Why Daddy's Law Firm Works with the Nice Oil Men",
	description = "A children's book about the complexities of contract law. On a chilly winter night, a little penguin dared to wonder: if daddy loves me, why does his law firm facilitate fossil fuel expansion?",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta
			property="og:image"
			content={`${import.meta.env.BASE_URL}WhyDaddysLawFirmworkswiththeNiceOilMen.jpg`}
		/>
		<link
			rel="icon"
			type="image/svg+xml"
			href={`${import.meta.env.BASE_URL}favicon.svg`}
		/>
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script
			defer
			src="https://cloud.umami.is/script.js"
			data-website-id="d0e3b86b-b601-4b5f-8dcd-c6d5d7d47558"></script>
	</head>
	<body>
		<slot />
	</body>
</html>
