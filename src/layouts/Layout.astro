---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Why Daddy's Law Firm Works with the Nice Oil Men",
	description = "A satirical children's book about law firms and fossil fuels",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script
			defer
			src="https://cloud.umami.is/script.js"
			data-website-id="d0e3b86b-b601-4b5f-8dcd-c6d5d7d47558"></script>
	</head>
	<body>
		<slot />
	</body>
</html>
