---
import Layout from "../layouts/Layout.astro";
import RotatingQuote from "../components/RotatingQuote.svelte";
import BookCarousel from "../components/BookCarousel.svelte";
import { Image } from "astro:assets";
import iconLogo from "../assets/SP-icon-logo-white.png";
import bookCover from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-01.jpg";
import blueBg from "../assets/illos/plain-blue-background.jpg";

// Import all book pages
import page01 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-01.jpg";
import page02 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-02.jpg";
import page03 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-03.jpg";
import page04 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-04.jpg";
import page05 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-05.jpg";
import page06 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-06.jpg";
import page07 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-07.jpg";
import page08 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-08.jpg";
import page09 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-09.jpg";
import page10 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-10.jpg";
import page11 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-11.jpg";
import page12 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-12.jpg";
import page13 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-13.jpg";
import page14 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-14.jpg";
import page15 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-15.jpg";
import page16 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-16.jpg";
import page17 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-17.jpg";
import page18 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-18.jpg";
import page19 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-19.jpg";
import page20 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-20.jpg";
import page21 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-21.jpg";
import page22 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-22.jpg";
import page23 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-23.jpg";
import page24 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-24.jpg";
import page25 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-25.jpg";
import page26 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-26.jpg";
import page27 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-27.jpg";
import page28 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-28.jpg";
import page29 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-29.jpg";
import page30 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-30.jpg";
import page31 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-31.jpg";
import page32 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-32.jpg";

const bookPages = [
	page01.src,
	page02.src,
	page03.src,
	page04.src,
	page05.src,
	page06.src,
	page07.src,
	page08.src,
	page09.src,
	page10.src,
	page11.src,
	page12.src,
	page13.src,
	page14.src,
	page15.src,
	page16.src,
	page17.src,
	page18.src,
	page19.src,
	page20.src,
	page21.src,
	page22.src,
	page23.src,
	page24.src,
	page25.src,
	page26.src,
	page27.src,
	page28.src,
	page29.src,
	page30.src,
	page31.src,
	page32.src,
];

const lawyerActions = [
	{
		title: "Learn the science and history.",
		description:
			"To fulfill their duty of competence, lawyers should stay up-to-date on climate risks, and understand the fossil fuel industry's history of deception.",
	},
	{
		title: "Expand ethics rules.",
		description:
			"Expand and enforce professional codes to explicitly prohibit misleading courts or the public about climate science.",
	},
	{
		title: "Disclose fossil fuel work.",
		description:
			"Require law firms to publicly report which oil and gas companies they represent and lobby for.",
	},
	{
		title: "Stop rewarding harmful work.",
		description:
			"Reform legal awards and rankings to stop celebrating lawyers destroying the planet.",
	},
	{
		title: "Give clients transparency.",
		description:
			"Create tools showing law firms' Scope 3 emissions, so clients can choose representation aligned with their values.",
	},
	{
		title: "Embed climate in firm decision-making.",
		description:
			"Make environmental and human rights considerations central to hiring, partnerships, career development, and firm governance.",
	},
	{
		title: "Refuse fossil fuel work.",
		description:
			"Doing so on a 'climate-related protected belief' means you are unlikely to face regulatory action.",
	},
];
---

<Layout>
	<!-- Snow Effect -->
	<canvas id="snow-canvas" class="snow-canvas"></canvas>

	<!-- Header -->
	<header
		class="fixed top-0 left-0 right-0 z-50 transition-colors duration-300"
		id="site-header"
	>
		<div class="max-w-6xl mx-auto px-6 py-5 flex items-center">
			<a
				href="https://seriouspeople.co"
				target="_blank"
				rel="noopener noreferrer"
			>
				<Image
					src={iconLogo}
					alt="Serious People"
					width={80}
					height={80}
					quality="high"
					class="sp-logo"
				/>
			</a>
		</div>
	</header>

	<!-- Hero Section -->
	<section class="hero">
		<Image src={blueBg} alt="" class="hero-bg" loading="eager" />
		<div class="hero-content">
			<div class="hero-quote">
				<RotatingQuote client:load />
			</div>

			<div class="hero-cover">
				<Image
					src={bookCover}
					alt="Why Daddy's Law Firm Works with the Nice Oil Men"
					class="hero-cover-img"
					loading="eager"
					quality="high"
				/>
			</div>

			<div class="hero-text">
				<p class="hero-blurb">
					On a chilly winter night, a little penguin dared to wonder:
					if daddy loves me, why does his law firm facilitate fossil
					fuel expansion?
				</p>
			</div>

			<div class="hero-actions">
				<a href="#read" class="btn btn-primary">Read the Book</a>
				<a href="#learn-more" class="btn btn-secondary">Learn More</a>
			</div>
		</div>
	</section>

	<!-- Book Reader Section -->
	<section id="read" class="section-reader">
		<BookCarousel
			bookPages={bookPages}
			pdfUrl="/penguin/why-daddys-law-firm-works-with-the-nice-oil-men-ebook.pdf"
			client:load
		/>
	</section>

	<!-- 7 Things Lawyers Can Do -->
	<section id="learn-more" class="section-seven">
		<Image src={blueBg} alt="" class="section-seven-bg" />
		<div class="section-seven-content">
			<div class="seven-header">
				<span class="seven-number">7</span>
				<h2 class="seven-title">Things<br />Lawyers<br />Can Do...</h2>
			</div>

			<div class="seven-grid">
				{
					lawyerActions.map((action, index) => (
						<div class="seven-item">
							<span class="seven-item-number">{index + 1}</span>
							<h3 class="seven-item-title">{action.title}</h3>
							<p class="seven-item-desc">{action.description}</p>
						</div>
					))
				}
			</div>

			<div class="did-you-know">
				<h3>Did You Know?</h3>
				<p>
					In 2024, the International Court of Justice ruled that
					countries have a legal duty to protect the climate and
					prevent harm to future generations, including fossil fuel
					expansion.
				</p>
				<p>
					Between 2020 and 2024, London law firms facilitated <strong
						>$59.84 billion</strong
					> in fossil fuel transactions.
				</p>
				<p>
					The world already has enough approved fossil fuel projects
					to push past 1.5°C of warming. The communities that
					contributed least to emissions will be hit first and
					hardest. Not including penguins, who didn't emit anything at
					all.
				</p>
				<p class="did-you-know-source">
					Source: The 2025 Law Firm Climate Change Scorecard by Law
					Students for Climate Accountability (LSCA)
				</p>
			</div>
		</div>
	</section>

	<!-- Footer -->
	<footer class="site-footer">
		<p>
			Made by <a
				href="https://seriouspeople.co"
				target="_blank"
				rel="noopener noreferrer">Serious People</a
			>
		</p>
		<p>
			Illustration by <a
				href="https://ellenmcgahey.com"
				target="_blank"
				rel="noopener noreferrer">Ellen McGahey</a
			>
		</p>
	</footer>
</Layout>

<style>
	/* ---- Snow Effect ---- */
	.snow-canvas {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 9999;
		opacity: 0.6;
	}

	/* ---- Header ---- */
	.sp-logo {
		width: 40px;
		height: 40px;
	}

	/* ---- Hero ---- */
	.hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	@media (max-width: 640px) {
		.hero {
			min-height: auto;
			align-items: flex-start;
		}

		.hero-content {
			padding-top: 8rem;
		}
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
	}

	.hero-content {
		position: relative;
		z-index: 1;
		text-align: center;
		padding: 6rem 1.5rem 4rem;
		max-width: 600px;
		margin: 0 auto;
	}

	.hero-quote {
		margin-bottom: 3rem;
		min-height: 8rem;
		display: flex;
		align-items: flex-start;
		justify-content: center;
	}

	@media (min-width: 768px) {
		.hero-quote {
			min-height: 9rem;
		}
	}

	.hero-cover {
		margin: 0 auto 2rem;
		max-width: 320px;
	}

	.hero-cover-img {
		width: 100%;
		height: auto;
		border-radius: 6px;
		box-shadow: 0 16px 48px rgba(0, 0, 0, 0.2);
	}

	.hero-text {
		margin-bottom: 2.5rem;
	}

	.hero-blurb {
		font-size: 1rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.9);
		max-width: 420px;
		margin: 0 auto;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	/* ---- Buttons ---- */
	.btn {
		display: inline-block;
		padding: 0.85rem 2rem;
		font-size: 1.05rem;
		font-family: "powell", sans-serif;
		border-radius: 4px;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.btn-primary {
		background: white;
		color: #237f8d;
	}

	.btn-primary:hover {
		background: #ede9e8;
	}

	.btn-secondary {
		background: transparent;
		color: white;
		border: 2px solid white;
	}

	.btn-secondary:hover {
		background: rgba(255, 255, 255, 0.15);
	}

	/* ---- Reader Section ---- */
	.section-reader {
		background: #ede9e8;
		padding: 4rem 0;
	}

	/* ---- 7 Things Section ---- */
	.section-seven {
		position: relative;
		overflow: hidden;
	}

	.section-seven-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
	}

	.section-seven-content {
		position: relative;
		z-index: 1;
		max-width: 960px;
		margin: 0 auto;
		padding: 5rem 1.5rem;
		color: white;
	}

	.seven-header {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		margin-bottom: 3rem;
	}

	.seven-number {
		font-size: 8rem;
		line-height: 0.75;
		color: white;
		opacity: 0.9;
		flex-shrink: 0;
	}

	.seven-title {
		font-size: 3rem;
		line-height: 1.05;
		font-weight: 400;
		margin: 0;
		padding-top: 0.25rem;
	}

	.seven-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		margin-bottom: 4rem;
	}

	@media (min-width: 640px) {
		.seven-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 900px) {
		.seven-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.seven-item {
		/* No animations */
	}

	.seven-item-number {
		font-size: 3rem;
		line-height: 1;
		display: block;
		margin-bottom: 0.25rem;
		opacity: 0.7;
	}

	.seven-item-title {
		font-size: 1.2rem;
		font-weight: 400;
		line-height: 1.3;
		margin: 0 0 0.5rem;
	}

	.seven-item-desc {
		font-size: 0.9rem;
		line-height: 1.5;
		opacity: 0.85;
		margin: 0;
	}

	/* ---- Did You Know ---- */
	.did-you-know {
		border-top: 1px solid rgba(255, 255, 255, 0.3);
		padding-top: 2.5rem;
		max-width: 640px;
	}

	.did-you-know h3 {
		font-size: 1.5rem;
		font-weight: 400;
		margin: 0 0 1rem;
	}

	.did-you-know p {
		font-size: 1rem;
		line-height: 1.6;
		opacity: 0.9;
		margin: 0 0 1rem;
	}

	.did-you-know-source {
		font-size: 0.85rem !important;
		opacity: 0.6 !important;
	}

	/* ---- Footer ---- */
	.site-footer {
		background: #ede9e8;
		padding: 2.5rem 1.5rem;
		text-align: center;
		color: #656d70;
		font-size: 0.95rem;
	}

	.site-footer p {
		margin: 0.25rem 0;
	}

	.site-footer a {
		color: #237f8d;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.site-footer a:hover {
		color: #1a6070;
	}

	/* ---- Responsive ---- */
	@media (min-width: 768px) {
		.hero-cover {
			max-width: 380px;
		}

		.hero-blurb {
			font-size: 1.15rem;
		}

		.seven-number {
			font-size: 10rem;
		}

		.seven-title {
			font-size: 3.5rem;
		}
	}
</style>

<script>
	// Cute snow effect
	if (typeof window !== "undefined") {
		document.addEventListener("DOMContentLoaded", () => {
			const canvas = document.getElementById(
				"snow-canvas",
			) as HTMLCanvasElement;
			if (!canvas) return;

			const ctxOrNull = canvas.getContext("2d");
			if (!ctxOrNull) return;
			const ctx: CanvasRenderingContext2D = ctxOrNull;

			canvas.width = window.innerWidth;
			canvas.height = window.innerHeight;

			const snowflakes: Array<{
				x: number;
				y: number;
				radius: number;
				speed: number;
				drift: number;
			}> = [];
			const maxSnowflakes = 50;

			// Create snowflakes
			for (let i = 0; i < maxSnowflakes; i++) {
				snowflakes.push({
					x: Math.random() * canvas.width,
					y: Math.random() * canvas.height,
					radius: Math.random() * 2 + 1,
					speed: Math.random() * 0.5 + 0.3,
					drift: Math.random() * 0.5 - 0.25,
				});
			}

			function animate() {
				ctx.clearRect(0, 0, canvas.width, canvas.height);
				ctx.fillStyle = "rgba(255, 255, 255, 0.8)";

				snowflakes.forEach((flake) => {
					ctx.beginPath();
					ctx.arc(flake.x, flake.y, flake.radius, 0, Math.PI * 2);
					ctx.fill();

					flake.y += flake.speed;
					flake.x += flake.drift;

					if (flake.y > canvas.height) {
						flake.y = -10;
						flake.x = Math.random() * canvas.width;
					}
				});

				requestAnimationFrame(animate);
			}

			animate();

			// Handle resize
			window.addEventListener("resize", () => {
				canvas.width = window.innerWidth;
				canvas.height = window.innerHeight;
			});
		});
	}
</script>
