---
import Layout from "../layouts/Layout.astro";
import RotatingQuote from "../components/RotatingQuote.svelte";
import BookCarousel from "../components/BookCarousel.svelte";
import { Image } from "astro:assets";
import iconLogo from "../assets/SP-icon-logo-white.png";
import bookCover from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-01.jpg";
import blueBg from "../assets/illos/plain-blue-background.jpg";
import backInfo from "../assets/illos/back-info.jpg";

// Import all book pages
import page01 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-01.jpg";
import page02 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-02.jpg";
import page03 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-03.jpg";
import page04 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-04.jpg";
import page05 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-05.jpg";
import page06 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-06.jpg";
import page07 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-07.jpg";
import page08 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-08.jpg";
import page09 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-09.jpg";
import page10 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-10.jpg";
import page11 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-11.jpg";
import page12 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-12.jpg";
import page13 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-13.jpg";
import page14 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-14.jpg";
import page15 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-15.jpg";
import page16 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-16.jpg";
import page17 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-17.jpg";
import page18 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-18.jpg";
import page19 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-19.jpg";
import page20 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-20.jpg";
import page21 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-21.jpg";
import page22 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-22.jpg";
import page23 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-23.jpg";
import page24 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-24.jpg";
import page25 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-25.jpg";
import page26 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-26.jpg";
import page27 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-27.jpg";
import page28 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-28.jpg";
import page29 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-29.jpg";
import page30 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-30.jpg";
import page31 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-31.jpg";
import page32 from "../assets/book/why-daddys-law-firm-works-with-the-nice-oil-men-32.jpg";

const bookPages = [
	page01.src,
	page02.src,
	page03.src,
	page04.src,
	page05.src,
	page06.src,
	page07.src,
	page08.src,
	page09.src,
	page10.src,
	page11.src,
	page12.src,
	page13.src,
	page14.src,
	page15.src,
	page16.src,
	page17.src,
	page18.src,
	page19.src,
	page20.src,
	page21.src,
	page22.src,
	page23.src,
	page24.src,
	page25.src,
	page26.src,
	page27.src,
	page28.src,
	page29.src,
	page30.src,
	page31.src,
	page32.src,
];

const lawyerActions = [
	{
		title: "Learn the science and history.",
		description:
			"To fulfill their duty of competence, lawyers should stay up-to-date on climate risks, and understand the fossil fuel industry's history of deception.",
	},
	{
		title: "Expand ethics rules.",
		description:
			"Expand and enforce professional codes to explicitly prohibit misleading courts or the public about climate science.",
	},
	{
		title: "Disclose fossil fuel work.",
		description:
			"Require law firms to publicly report which oil and gas companies they represent and lobby for.",
	},
	{
		title: "Stop rewarding harmful work.",
		description:
			"Reform legal awards and rankings to stop celebrating lawyers destroying the planet.",
	},
	{
		title: "Give clients transparency.",
		description:
			"Create tools showing law firms' Scope 3 emissions, so clients can choose representation aligned with their values.",
	},
	{
		title: "Embed climate in firm decision-making.",
		description:
			"Make environmental and human rights considerations central to hiring, partnerships, career development, and firm governance.",
	},
	{
		title: "Refuse fossil fuel work.",
		description:
			"Doing so on a 'climate-related protected belief' means you are unlikely to face regulatory action.",
	},
];
---

<Layout>
	<!-- Snow Effect -->
	<canvas id="snow-canvas" class="fixed inset-0 w-full h-full pointer-events-none z-[9999] opacity-60"></canvas>

	<!-- Header -->
	<header
		class="fixed top-0 left-0 right-0 z-50 transition-colors duration-300"
		id="site-header"
	>
		<div class="max-w-6xl mx-auto px-6 py-5 flex items-center">
			<a
				href="https://seriouspeople.co"
				target="_blank"
				rel="noopener noreferrer"
			>
				<Image
					src={iconLogo}
					alt="Serious People"
					width={80}
					height={80}
					quality="high"
					class="w-10 h-10"
				/>
			</a>
		</div>
	</header>

	<!-- Hero Section -->
	<section class="relative min-h-screen flex items-center justify-center overflow-hidden max-sm:min-h-0 max-sm:items-start">
		<Image src={blueBg} alt="" class="absolute inset-0 w-full h-full object-cover z-0" loading="eager" />
		<div class="relative z-10 text-center px-6 pt-24 pb-16 max-w-[600px] mx-auto max-sm:pt-32">
			<div class="mb-12 min-h-32 md:min-h-36 flex items-start justify-center">
				<RotatingQuote client:load />
			</div>

			<div class="mx-auto mb-8 max-w-[320px] md:max-w-[380px]">
				<Image
					src={bookCover}
					alt="Why Daddy's Law Firm Works with the Nice Oil Men"
					class="w-full h-auto rounded-[6px] shadow-[0_16px_48px_rgba(0,0,0,0.2)]"
					loading="eager"
					quality="high"
				/>
			</div>

			<div class="mb-10">
				<p class="text-base md:text-lg leading-relaxed text-white/90 max-w-[420px] mx-auto">
					On a chilly winter night, a little penguin dared to wonder:
					if daddy loves me, why does his law firm facilitate fossil
					fuel expansion?
				</p>
			</div>

			<div class="flex gap-4 justify-center flex-wrap">
				<a href="#read" class="inline-block px-8 py-[0.85rem] text-[1.05rem] font-[powell] rounded bg-white text-teal no-underline transition-all duration-200 hover:bg-offwhite">Read the Book</a>
				<a href="#learn-more" class="inline-block px-8 py-[0.85rem] text-[1.05rem] font-[powell] rounded bg-transparent text-white border-2 border-white no-underline transition-all duration-200 hover:bg-white/15">Learn More</a>
			</div>
		</div>
	</section>

	<!-- Book Reader Section -->
	<section id="read" class="bg-offwhite py-16">
		<BookCarousel
			bookPages={bookPages}
			pdfUrl="/penguin/why-daddys-law-firm-works-with-the-nice-oil-men-ebook.pdf"
			client:load
		/>
	</section>

	<!-- Did You Know Section -->
	<section id="learn-more" class="relative overflow-hidden py-20 px-6">
		<Image src={backInfo} alt="" class="absolute inset-0 w-full h-full object-cover z-0" />
		<div class="relative z-10 max-w-[960px] mx-auto">
			<h2 class="text-5xl md:text-6xl font-normal mb-8 md:mb-10 text-grey text-center">Did you know?</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-12 md:items-start">
				<div class="text-center">
					<p class="text-[1.05rem] leading-relaxed text-grey mb-4">
						In 2025, the International Court of Justice ruled that
						countries have a legal duty to protect the climate and
						prevent harm to future generations, including fossil
						fuel expansion. This includes regulating the private
						sector.
					</p>
					<p class="text-[1.05rem] leading-relaxed text-grey mb-4">
						Between 2020 and 2024, London law firms facilitated
					</p>
					<div class="mt-1">
						<p class="text-4xl md:text-[2.75rem] leading-[1.1] text-grey font-normal">$59.84 billion</p>
						<p class="text-[0.95rem] text-grey mt-1">in fossil fuel transactions*</p>
					</div>
				</div>
				<div class="text-center">
					<p class="text-[1.05rem] leading-relaxed text-grey mb-4">
						The world already has enough approved fossil fuel
						projects to push past 1.5°C of warming. Each 0.1°C
						beyond that increases:
					</p>
					<p class="text-[1.2rem] leading-[1.55] text-grey my-4">
						Deadly heat waves and crop failures.<br />
						Mass displacement and climate refugees.<br />
						Wildfires, flooding and storms.
					</p>
					<p class="text-base leading-[1.5] text-grey mt-3">
						The communities that contributed least to emissions will
						be hit first and hardest. Including penguins, who didn't
						emit anything at all.
					</p>
				</div>
			</div>
			<p class="text-xs opacity-50 mt-10 text-grey text-center">
				*Source: The 2025 Law Firm Climate Change Scorecard by Law
				Students for Climate Accountability (LSCA)
			</p>
		</div>
	</section>

	<!-- 7 Things Lawyers Can Do -->
	<section class="relative overflow-hidden">
		<Image src={blueBg} alt="" class="absolute inset-0 w-full h-full object-cover z-0" />
		<div class="relative z-10 max-w-[960px] mx-auto py-20 px-6 text-white">
			<div class="flex items-start gap-4 mb-12">
				<span class="text-[8rem] md:text-[10rem] leading-[0.75] text-white opacity-90 shrink-0">7</span>
				<h2 class="text-5xl md:text-[3.5rem] leading-[1.05] font-normal m-0 pt-1">Things<br />Lawyers<br />Can Do...</h2>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 min-[900px]:grid-cols-3 gap-10 mb-16">
				{
					lawyerActions.map((action, index) => (
						<div>
							<span class="text-5xl leading-none block mb-1 opacity-70">{index + 1}</span>
							<h3 class="text-[1.35rem] font-normal leading-[1.3] m-0 mb-2">{action.title}</h3>
							<p class="text-[1.05rem] leading-[1.55] opacity-85 m-0">{action.description}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="bg-offwhite py-20 px-6 text-center">
		<div class="max-w-[520px] mx-auto">
			<h2 class="text-[2.5rem] font-normal mb-2 text-teal">Limited Print Run</h2>
			<p class="text-[1.2rem] text-grey mb-8">Order your free copy today.</p>
			<form action="https://submit-form.com/p6ynEPuSc" class="mb-8">
				<div class="flex flex-col sm:flex-row gap-3 mb-4">
					<input
						type="text"
						id="name"
						name="name"
						placeholder="Your name"
						required
						class="flex-1 px-4 py-[0.85rem] font-[powell] text-base border-2 border-blue rounded bg-white text-grey outline-none transition-colors duration-200 placeholder:text-grey/50 focus:border-teal"
					/>
					<input
						type="email"
						id="email"
						name="email"
						placeholder="Your email"
						required
						class="flex-1 px-4 py-[0.85rem] font-[powell] text-base border-2 border-blue rounded bg-white text-grey outline-none transition-colors duration-200 placeholder:text-grey/50 focus:border-teal"
					/>
				</div>
				<textarea
					id="message"
					name="message"
					placeholder="Message (optional)"
					class="w-full px-4 py-[0.85rem] font-[powell] text-base border-2 border-blue rounded bg-white text-grey outline-none transition-colors duration-200 mb-4 min-h-[120px] resize-y placeholder:text-grey/50 focus:border-teal"
				></textarea>
				<button type="submit" class="inline-block px-10 py-[0.85rem] text-[1.05rem] font-[powell] rounded border-none bg-teal text-white cursor-pointer transition-colors duration-200 hover:bg-teal-dark">Request a Copy</button>
			</form>
			<p class="text-base text-grey/70 italic m-0">
				Please forward to the lawyer in your life.
			</p>
		</div>
	</section>

	<!-- Footer -->
	<footer class="bg-offwhite py-10 px-6 text-center text-grey text-[0.95rem]">
		<p class="my-1">
			Made by <a
				href="https://seriouspeople.co"
				target="_blank"
				rel="noopener noreferrer"
				class="text-teal underline underline-offset-2 hover:text-teal-dark">Serious People</a
			>
		</p>
		<p class="my-1">
			Illustration by <a
				href="https://ellenmcgahey.com"
				target="_blank"
				rel="noopener noreferrer"
				class="text-teal underline underline-offset-2 hover:text-teal-dark">Ellen McGahey</a
			>
		</p>
	</footer>
</Layout>


<script>
	// Cute snow effect
	if (typeof window !== "undefined") {
		document.addEventListener("DOMContentLoaded", () => {
			const canvas = document.getElementById(
				"snow-canvas",
			) as HTMLCanvasElement;
			if (!canvas) return;

			const ctxOrNull = canvas.getContext("2d");
			if (!ctxOrNull) return;
			const ctx: CanvasRenderingContext2D = ctxOrNull;

			canvas.width = window.innerWidth;
			canvas.height = window.innerHeight;

			const snowflakes: Array<{
				x: number;
				y: number;
				radius: number;
				speed: number;
				drift: number;
			}> = [];
			const maxSnowflakes = 50;

			// Create snowflakes
			for (let i = 0; i < maxSnowflakes; i++) {
				snowflakes.push({
					x: Math.random() * canvas.width,
					y: Math.random() * canvas.height,
					radius: Math.random() * 2 + 1,
					speed: Math.random() * 0.5 + 0.3,
					drift: Math.random() * 0.5 - 0.25,
				});
			}

			function animate() {
				ctx.clearRect(0, 0, canvas.width, canvas.height);
				ctx.fillStyle = "rgba(255, 255, 255, 0.8)";

				snowflakes.forEach((flake) => {
					ctx.beginPath();
					ctx.arc(flake.x, flake.y, flake.radius, 0, Math.PI * 2);
					ctx.fill();

					flake.y += flake.speed;
					flake.x += flake.drift;

					if (flake.y > canvas.height) {
						flake.y = -10;
						flake.x = Math.random() * canvas.width;
					}
				});

				requestAnimationFrame(animate);
			}

			animate();

			// Handle resize
			window.addEventListener("resize", () => {
				canvas.width = window.innerWidth;
				canvas.height = window.innerHeight;
			});
		});
	}
</script>
